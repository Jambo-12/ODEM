# Copy this file to .env and fill in the required values.
# Never commit real credentials.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1

# Plan, Reason, and Reflect (Video-MME and M3-Bench).
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com

# Qwen3.5-Omni speaker-aware ASR. This is separate from the reasoning model.
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# M3-Bench semantic judge.
JUDGE_API_KEY=replace_with_your_openai_api_key
JUDGE_API_BASE=https://api.openai.com/v1

# Optional overrides. Defaults already point into this repository.
# ODEM_PREPROCESS_CONFIG=/absolute/path/to/ODEM/config/preprocess.yaml
# ODEM_PYTHON_BIN=python
# VIDEOMME_GPU_ID=0
# M3_BENCH_GPU_ID=0
